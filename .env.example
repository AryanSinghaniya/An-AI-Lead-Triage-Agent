OPENAI_API_KEY=your_openai_api_key_here

# ── Optional: Google Sheets integration (live mode) ──────────────────────────
# Get these from Google Cloud Console → Service Accounts → JSON key
# Leave blank to run in demo mode (reads from data/leads.csv instead)
GOOGLE_CREDENTIALS_PATH=

# The Sheet ID from the URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads

# ── Optional: Gmail draft integration (live mode) ─────────────────────────────
# Same service account credentials are used. If left blank, drafts save locally.
GMAIL_SENDER_ADDRESS=
